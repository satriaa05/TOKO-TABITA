APP_NAME=Toko Tabita
APP_ENV=production
APP_KEY=
# WAJIB: set ke false di production! true akan membocorkan stack trace ke pengunjung.
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -------------------------------------------------------------------
# Identitas toko publik (dapat ditimpa Owner dari menu Pengaturan Bisnis)
# -------------------------------------------------------------------
TABITA_STORE_NAME="Tabita Modiste"
TABITA_STORE_WHATSAPP="+62 831-2881-4776"
TABITA_STORE_LOCATION="Semarang, Jawa Tengah, Indonesia"
TABITA_STORE_TAGLINE="Fashion for Every You"
TABITA_STORE_DESCRIPTION="Garment premium, harga terjangkau sejak 1999."
TABITA_STORE_HOURS=
TABITA_STORE_ADDRESS=
TABITA_INSTAGRAM_URL=
TABITA_STORE_POSTAL_CODE=50131
TABITA_SHIPPING_DEFAULT=17000
TABITA_SHIPPING_MAX_COST=17000
TABITA_SHIPPING_FREE_THRESHOLD=300000
TABITA_INSTANT_MAX_KM=30

# -------------------------------------------------------------------
# Midtrans (QRIS dinamis, e-wallet, VA) - SEMUA kredensial di .env
# -------------------------------------------------------------------
PAYMENT_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_API_URL=https://api.sandbox.midtrans.com
MIDTRANS_EXPIRY_MINUTES=30
MIDTRANS_NOTIFICATION_URL=

# Rekening toko untuk transfer manual (fallback)
TABITA_BANK_NAME=
TABITA_BANK_HOLDER=
TABITA_BANK_ACCOUNT=

# -------------------------------------------------------------------
# Biteship (ongkir + tracking) dan Peta GRATIS (Leaflet + OpenStreetMap)
# -------------------------------------------------------------------
SHIPPING_PROVIDER=biteship
BITESHIP_API_KEY=
BITESHIP_WEBHOOK_TOKEN=
BITESHIP_WEBHOOK_HEADER=Tabita-Modiste-Signature
BITESHIP_API_URL=https://api.biteship.com
BITESHIP_WEBHOOK_URL=
BITESHIP_POLL_SECONDS=15

# Tidak perlu API key / kartu kredit. Ubah UA sebelum production.
TABITA_MAPS_USER_AGENT="TabitaModiste/1.0 (local development)"
TABITA_GEOCODE_URL=https://nominatim.openstreetmap.org/search
TABITA_ROUTE_URL=https://router.project-osrm.org/route/v1/driving

# -------------------------------------------------------------------
# Email notifikasi (Resend direkomendasikan; log untuk development)
# -------------------------------------------------------------------
MAIL_MAILER=log
RESEND_API_KEY=
