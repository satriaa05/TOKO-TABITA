# ===================================================================
# CONTOH .env UNTUK PRODUKSI (SHARED HOSTING)
# ===================================================================
# Salin file ini menjadi .env di server, lalu isi nilai yang ditandai
# <<ISI>>. Jangan pernah commit .env ke git / jangan taruh di public/.
# ===================================================================

APP_NAME="Tabita Modiste"
APP_ENV=production
APP_KEY=base64:<<ISI_APP_KEY>>
APP_DEBUG=false
APP_URL=https://<<ISI_DOMAIN>>
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ----- Database MySQL (dari cPanel) -----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<<ISI_NAMA_DB>>
DB_USERNAME=<<ISI_USER_DB>>
DB_PASSWORD=<<ISI_PASSWORD_DB>>

# ----- Session, cache, queue (sudah memakai tabel) -----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ----- Mail: Resend direkomendasikan -----
MAIL_MAILER=resend
RESEND_API_KEY=<<ISI_RESEND_KEY>>
MAIL_FROM_ADDRESS="no-reply@<<ISI_DOMAIN_TERVERIFIKASI>>"
MAIL_FROM_NAME="${APP_NAME}"

# ----- Identitas toko -----
TABITA_STORE_NAME="Tabita Modiste"
TABITA_STORE_WHATSAPP="+62 831-2881-4776"
TABITA_STORE_LOCATION="Semarang, Jawa Tengah, Indonesia"
TABITA_STORE_TAGLINE="Fashion for Every You"
TABITA_STORE_DESCRIPTION="Garment premium, harga terjangkau sejak 2010."
TABITA_STORE_HOURS="Senin - Sabtu, 09.00 - 18.00 WIB"
TABITA_STORE_ADDRESS=
TABITA_INSTAGRAM_URL=
TABITA_STORE_POSTAL_CODE=50131
TABITA_SHIPPING_DEFAULT=17000
TABITA_SHIPPING_MAX_COST=17000
TABITA_SHIPPING_FREE_THRESHOLD=300000
TABITA_INSTANT_MAX_KM=30

# ----- Midtrans -----
# Sandbox: MIDTRANS_IS_PRODUCTION=false, API=https://api.sandbox.midtrans.com
# Live   : MIDTRANS_IS_PRODUCTION=true,  API=https://api.midtrans.com
PAYMENT_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=<<ISI>>
MIDTRANS_CLIENT_KEY=<<ISI>>
MIDTRANS_MERCHANT_ID=<<ISI>>
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_API_URL=https://api.sandbox.midtrans.com
MIDTRANS_EXPIRY_MINUTES=30
MIDTRANS_NOTIFICATION_URL=https://<<ISI_DOMAIN>>/payments/midtrans/webhook

# ----- Rekening transfer manual (fallback) -----
TABITA_BANK_NAME=BCA
TABITA_BANK_HOLDER=Tabita Modiste
TABITA_BANK_ACCOUNT=<<ISI>>

# ----- Biteship -----
SHIPPING_PROVIDER=biteship
BITESHIP_API_KEY=<<ISI>>
BITESHIP_WEBHOOK_TOKEN=<<ISI>>
BITESHIP_WEBHOOK_HEADER=Tabita-Modiste-Signature
BITESHIP_API_URL=https://api.biteship.com
BITESHIP_WEBHOOK_URL=https://<<ISI_DOMAIN>>/shipping/biteship/webhook
BITESHIP_POLL_SECONDS=15

# ----- Peta GRATIS: Leaflet + OpenStreetMap (tanpa API key) -----
# Gunakan UA dengan domain/email kontak toko sebelum production.
TABITA_MAPS_USER_AGENT="TabitaModiste/1.0 (https://<<ISI_DOMAIN>>)"
TABITA_GEOCODE_URL=https://nominatim.openstreetmap.org/search
TABITA_ROUTE_URL=https://router.project-osrm.org/route/v1/driving
